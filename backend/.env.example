# Comma-separated browser origins allowed to call the local API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
LOG_LEVEL=INFO

# Phase 3 RAG runtime. Copy this file to .env and set the real key locally.
# RAG_INDEX_DIR must point to the pre-built chroma_500_50 directory.
RAG_INDEX_DIR=./rag_data/chroma_500_50
FASTEMBED_CACHE_DIR=./rag_data/fastembed_cache
FASTEMBED_MODEL=BAAI/bge-base-en-v1.5
CHROMA_COLLECTION=diabetes_500_50
RETRIEVAL_SCORE_THRESHOLD=0.23
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
RUN_RAG_SMOKE_TESTS=0
